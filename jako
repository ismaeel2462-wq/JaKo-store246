    }


    // ==========================================
    // التعامل مع طريقة الدفع
    // ==========================================

    function handlePaymentChange() {

        const method =
            document.getElementById("paymentMethod").value;


        const notice =
            document.getElementById("paymentNotice");


        const googleGroup =
            document.getElementById("googleCodeGroup");


        const modal =
            document.getElementById("qrModal");


        notice.style.display = "none";

        googleGroup.style.display = "none";

        modal.style.display = "none";


        // شام كاش
        if (method === "شام كاش") {

            notice.style.display = "block";


            notice.innerHTML =
                "💰 تم اختيار شام كاش. يرجى إتمام التحويل من خلال النافذة.";


            document.getElementById("accountNum").innerText =
                CHAM_CASH_ACCOUNT;


            modal.style.display = "flex";

        }


        // Google Play
        else if (method === "بطاقات جوجل بلاي") {

            googleGroup.style.display = "block";


            notice.style.display = "block";


            notice.innerHTML =
                "💳 يرجى كتابة كود بطاقة جوجل بلاي بالأسفل بدقة.";

        }

    }


    // ==========================================
    // إغلاق نافذة شام كاش
    // ==========================================

    function closePopup() {

        document.getElementById("qrModal").style.display =
            "none";

    }


    // ==========================================
    // تأكيد شام كاش
    // ==========================================

    async function confirmChamCash() {

        // التحقق من تسجيل الدخول
        const session =
            await checkLogin();


        if (!session) {

            closePopup();


            alert(
                "🔐 يجب تسجيل الدخول أولًا لإرسال الطلب."
            );


            // حفظ الصفحة الحالية
            localStorage.setItem(
                "returnAfterLogin",
                window.location.href
            );


            // الذهاب لتسجيل الدخول
            window.location.href =
                "login.html";


            return;

        }


        const method =
            document.getElementById("paymentMethod").value;


        if (method !== "شام كاش") {

            closePopup();

            return;

        }


        closePopup();


        sendWhatsAppOrder();

    }


    // ==========================================
    // زر إرسال الطلب
    // ==========================================

    async function redirectToWhatsApp() {

        // التحقق من تسجيل الدخول
        const session =
            await checkLogin();


        if (!session) {

            alert(
                "🔐 يجب تسجيل الدخول أولًا لإرسال الطلب."
            );


            // حفظ الصفحة الحالية
            localStorage.setItem(
                "returnAfterLogin",
                window.location.href
            );


            // الذهاب إلى صفحة تسجيل الدخول
            window.location.href =
                "login.html";


            return;

        }


        const id =
            document.getElementById("playerId").value.trim();


        const method =
            document.getElementById("paymentMethod").value;


        // التحقق من البيانات
        if (!id || !method) {

            alert(
                "الرجاء إدخال الـ ID واختيار طريقة الدفع!"
            );


            return;

        }


        // شام كاش
        if (method === "شام كاش") {

            document.getElementById("qrModal").style.display =
                "flex";


            return;

        }


        // Google Play
        if (method === "بطاقات جوجل بلاي") {

            const gCode =
                document.getElementById("googleCode").value.trim();


            if (!gCode) {

                alert(
                    "الرجاء إدخال كود بطاقة جوجل بلاي!"
                );


                return;

            }

        }


        // إرسال الطلب
        sendWhatsAppOrder();

    }


    // ==========================================
    // إنشاء رسالة واتساب
    // ==========================================

    function sendWhatsAppOrder() {

        const id =
            document.getElementById("playerId").value.trim();


        const pkg =
            document.getElementById("package").value;


        const method =
            document.getElementById("paymentMethod").value;


        const gCode =
            document.getElementById("googleCode").value.trim();


        let message =
`🎮 طلب شحن ببجي موبايل جديد

🆔 Player ID: ${id}

📦 الباقة:
${pkg}

💳 طريقة الدفع:
${method}`;


        // إضافة كود Google Play
        if (method === "بطاقات جوجل بلاي") {

            message +=
`\n\n🔑 كود بطاقة جوجل بلاي:
${gCode}`;

        }


        // إنشاء رابط واتساب
        const whatsappURL =
            "https://wa.me/" +
            WHATSAPP_NUMBER +
            "?text=" +
            encodeURIComponent(message);


        // فتح واتساب
        window.open(
            whatsappURL,
            "_blank"
        );

    }


    // ==========================================
    // إغلاق النافذة عند الضغط خارجها
    // ==========================================

    window.onclick = function(event) {

        const modal =
            document.getElementById("qrModal");


        if (event.target === modal) {

            closePopup();

        }

    };

</script>

