        <p>قم بمسح الكود أدناه لإرسال الأموال:</p>
        <div class="qrcode-box">
            <img src="qr-code.png" alt="[ضع صورتك باسم qr-code.png هنا]" class="qrcode-img" onerror="this.style.display='none';">
        </div>
        <p style="font-size: 15px; color: #ccc;">رقم الحساب: <strong style="color:#ff9800;" id="accountNum">09xxxxxxxx</strong></p>
        <button class="btn-close" onclick="closePopup()">موافق، تم التحويل</button>
    </div>
</div>

<script>
    const WHATSAPP_NUMBER = "9639xxxxxxxx"; 
    const CHAM_CASH_ACCOUNT = "09xxxxxxxx"; 

    function handlePaymentChange() {
        const method = document.getElementById("paymentMethod").value;
        const notice = document.getElementById("paymentNotice");
        const googleGroup = document.getElementById("googleCodeGroup");
        const modal = document.getElementById("qrModal");

        notice.style.display = "none"; googleGroup.style.display = "none"; modal.style.display = "none";

        if (method === "شام كاش") {
            notice.style.display = "block";
            notice.innerHTML = "🎯 تم فتح نافذة باركود شام كاش، يرجى إتمام التحويل.";
            document.getElementById("accountNum").innerText = CHAM_CASH_ACCOUNT;
            modal.style.display = "flex"; 
        } else if (method === "بطاقات جوجل بلاي") {
            googleGroup.style.display = "block"; notice.style.display = "block";
            notice.innerHTML = "💳 يرجى كتابة كود البطاقة بالأسفل بدقة.";
        }
    }

    function closePopup() { document.getElementById("qrModal").style.display = "none"; }

    function redirectToWhatsApp() {
        const id = document.getElementById("playerId").value;
        const pkg = document.getElementById("package").value;
        const method = document.getElementById("paymentMethod").value;
        const gCode = document.getElementById("googleCode").value;

        if (!id || !method) { alert("الرجاء إدخال الـ ID واختيار طريقة الدفع!"); return; }
        if (method === "بطاقات جوجل بلاي" && !gCode.trim()) { alert("الرجاء إدخال كود بطاقة جوجل بلاي!"); return; }

        let text = "طلب شحن فري فاير جديد:%0A🆔 المعرّف (ID): " + id + "%0A📦 الفئة: " + pkg + "%0A💳 الدفع عن طريق: " + method;
        if (method === "بطاقات جوجل بلاي") text += "%0A🔑 كود البطاقة: " + gCode;
        window.open("https://wa.me" + WHATSAPP_NUMBER + "?text=" + text, '_blank');
    }
</script>
