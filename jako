    </style>
</head>
<body>
<div class="container">
    <!-- زر الرجوع إلى الواجهة الرئيسية -->
<div style="text-align: right; margin-bottom: 20px;">
    <a href="index.html" style="background: #2a2a2a; color: #ff9800; border: 1px solid #ff9800; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: bold; transition: 0.3s; display: inline-block;">
        ⬅️
    </a>
</div>
    <h1>🧱 شحن روبلوكس - Roblox Robux</h1>
    <form id="orderForm">
        <div class="form-group">
            <label>أدخل اسم حسابك في روبلوكس (Username):</label>
            <input type="text" id="playerId" placeholder="أدخل اسم الحساب" required>
        </div>
        <div class="form-group">
            <label>اختر كمية الروبوكس (Robux):</label>
            <select id="package">
                <option value="80 روبوكس (Robux) - 0.99$">80 روبوكس (Robux) - 0.99$</option>
                <option value="400 روبوكس (Robux) - 5.99$">400 روبوكس (Robux) - 5.99$</option>
                <option value="800 روبوكس (Robux) - 10.99$">800 روبوكس (Robux) - 10.99$</option>
                <option value="1700 روبوكس (Robux) - 20.99$">1700 روبوكس (Robux) - 20.99$</option>
                <option value="4500 روبوكس (Robux) - 51.99$">4500 روبوكس (Robux) - 51.99$</option>
            </select>
        </div>
        <div class="form-group">
            <label>طريقة الدفع:</label>
            <select id="paymentMethod" onchange="handlePaymentChange()">
                <option value="">-- اختر طريقة الدفع --</option>
                <option value="شام كاش">شام كاش (Cham Cash)</option>
                <option value="بطاقات جوجل بلاي">بطاقة جوجل بلاي (Google Play)</option>
            </select>
            <div id="paymentNotice" class="notice"></div>
        </div>
        <div class="form-group" id="googleCodeGroup" style="display: none;">
            <label>أدخل كود بطاقة جوجل بلاي:</label>
            <input type="text" id="googleCode" placeholder="أدخل الـ 16 رمزاً الخاص بالبطاقة">
        </div>
        <button type="button" class="btn-submit" onclick="redirectToWhatsApp()">إرسال الطلب عبر الواتساب 💬</button>
    </form>
</div>
<div id="qrModal" class="modal">
    <div class="modal-content">
        <span class="close-icon" onclick="closePopup()">&times;</span>
        <h3>📲 مسح باركود شام كاش</h3>
        <p>قم بمسح الكود أدناه لإرسال الأموال:</p>
        <div class="qrcode-box"><img src="qr-code.png" alt="[ضع صورتك باسم qr-code.png هنا]" class="qrcode-img" onerror="this.style.display='none';"></div>
        <p style="font-size: 15px; color: #ccc;">رقم الحساب: <strong style="color:#ff9800;" id="accountNum">جاري التحميل...</strong></p>
        <button class="btn-close" onclick="closePopup()">موافق، تم التحويل</button>
    </div>
</div>
<script>
    const WHATSAPP_NUMBER = "9639xxxxxxxx"; const CHAM_CASH_ACCOUNT = "09xxxxxxxx";
    function handlePaymentChange() {
        const method = document.getElementById("paymentMethod").value;
        const notice = document.getElementById("paymentNotice");
        const googleGroup = document.getElementById("googleCodeGroup");
        const modal = document.getElementById("qrModal");
        notice.style.display = "none"; googleGroup.style.display = "none"; modal.style.display = "none";
        if (method === "شام كاش") {
            notice.style.display = "block"; notice.innerHTML = "🎯 تم فتح نافذة باركود شام كاش، يرجى إتمام التحويل.";
            document.getElementById("accountNum").innerText = CHAM_CASH_ACCOUNT; modal.style.display = "flex"; 
        } else if (method === "بطاقات جوجل بلاي") {
            googleGroup.style.display = "block"; notice.style.display = "block"; notice.innerHTML = "💳 يرجى كتابة كود البطاقة بالأسفل بدقة.";
        }
    }
    function closePopup() { document.getElementById("qrModal").style.display = "none"; }
    function redirectToWhatsApp() {
        const id = document.getElementById("playerId").value; const pkg = document.getElementById("package").value;
        const method = document.getElementById("paymentMethod").value; const gCode = document.getElementById("googleCode").value;
        if (!id || !method) { alert("الرجاء إدخال اسم الحساب واختيار طريقة الدفع!"); return; }
        if (method === "بطاقات جوجل بلاي" && !gCode.trim()) { alert("الرجاء إدخال كود بطاقة جوجل بلاي!"); return; }
        let text = "طلب شحن روبلوكس جديد:%0A🆔 اسم الحساب (Username): " + id + "%0A📦 الفئة: " + pkg + "%0A💳 الدفع عن طريق: " + method;
        if (method === "بطاقات جوجل بلاي") text += "%0A🔑 كود البطاقة: " + gCode;
        window.open("https://wa.me" + WHATSAPP_NUMBER + "?text=" + text, '_blank');
    }
</script>
</body>
